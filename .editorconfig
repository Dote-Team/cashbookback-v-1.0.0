# ==============================================================================
#  إعدادات تنسيق موحّدة للمشروع
#
#  الغرض: منع اختلاف المسافات البادئة بين ملفات C#.
#  وقع هذا فعلاً: سبعة ملفات صارت بمسافات بينما بقية المشروع بجبر (TAB)،
#  فامتلأ سجل Git بفروق لا معنى لها تُخفي التغييرات الحقيقية عند المراجعة.
#  ملفات C# في هذا المشروع مكتوبة بالجبر — والالتزام بذلك إلزامي.
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# ملفات C#: جبر (TAB) كما هو حال المشروع الحالي
[*.cs]
indent_style = tab
indent_size = 4

# بقية الملفات: مسافات
[*.{json,csproj,sln,props,targets,md,yml,yaml,html,css,js,ts,tsx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
