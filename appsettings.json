{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5003"
      }
    }
  },

  // ============================================================================
  //  خادم البريد — إرسال إشعار للعضو عند إضافته إلى منشأة.
  //
  //  ملاحظات قبل الضبط:
  //   • Enabled = false يعطّل الإرسال كاملاً بلا أي محاولة اتصال.
  //     إضافة العضو تنجح دائماً، وتُعاد حالة البريد في الاستجابة (emailSent).
  //   • لا تُكتب كلمة المرور هنا أبداً — ضعها في .env:
  //         MailSettings__Password=...            و   MailSettings__Email=...
  //   • UseSsl: true مع المنفذ 587 = STARTTLS، ومع المنفذ 465 = SSL من أول الاتصال.
  //     الخوادم العامة (Gmail / Outlook / Exchange) ترفض الاتصال بلا تشفير.
  //   • TimeoutSeconds يمنع تعليق الطلب على خادم لا يستجيب.
  // ============================================================================
  "MailSettings": {
    "Enabled": false,
    "FromName": "نظام الحسابات",
    "FromEmail": "",
    "SmtpServer": "",
    "SmtpPort": 587,
    "Email": "",
    "Password": "",
    "UseSsl": true,
    "TimeoutSeconds": 15
  },

  // عناوين الإنتاج فقط. localhost للتطوير موجود في appsettings.Development.json.
  "CorsSettings": {
    "AllowedOrigins": [
      "https://backsmartgis.live"
    ]
  },

  // ============================================================================
  //  الوكيل العكسي (Nginx / Docker): عناوين الوكلاء الموثوقين الذين يُقبل منهم
  //  X-Forwarded-For. بدونها يرى الخادم عنوان الوكيل لكل الطلبات، فتصبح حماية
  //  محاولات الدخول وتحديد المعدل مشتركة بين كل المستخدمين.
  //  أمثلة: "172.16.0.0/12" لشبكة Docker، أو "10.0.0.5" لوكيل واحد.
  // ============================================================================
  "ReverseProxy": {
    "KnownNetworks": []
  },

  // عدد طلبات الدخول وتجديد الرمز المسموحة في الدقيقة لكل عنوان IP.
  "RateLimiting": {
    "LoginPerMinute": 10,
    "RefreshPerMinute": 30
  },

  // المرفقات: صور JPG/PNG/GIF/WEBP و PDF فقط، يُتحقق من نوعها من محتواها لا من امتدادها.
  //  LinkLifetimeHours: مدة صلاحية رابط المرفق الموقّع الذي يصدره الخادم مع بيانات القيد.
  "Uploads": {
    "MaxFileSizeMb": 10,
    "MaxFilesPerRequest": 5,
    "LinkLifetimeHours": 12
  },

  "AllowedHosts": "*",

  // الحساب الذي يُمنح صلاحية «المدير الرئيسي» (Super Admin) تلقائياً عند الإقلاع.
  // تُطابَق باسم المستخدم أولاً ثم بالبريد. اتركهما فارغين لتعطيل المنح التلقائي.
  // ملاحظة: الحقلان Password و Role كانا موجودين هنا دون أن يقرأهما أي كود، وقد حُذفا
  // لأنهما كلمة مرور صريحة غير مستخدمة في ملف إعدادات.
  "AdminUser": {
    "Username": "",
    "Email": "",
    // لا تُكتب هنا: AdminUser__Password في .env (يُستخدم عند إنشاء السوبر أدمن أول مرة فقط)
    "Password": ""
  },
  // ============================================================================
  //  الدخول بالبصمة (ZK9500): الصورة تُلتقط في البرنامج الوسيط على جهاز المستخدم،
  //  والمطابقة هنا في الخادم. المفتاح EncryptionKey يوضع في .env لا هنا.
  //   • Matcher: sourceafis (الإنتاج) أو dev (التطوير فقط).
  //   • MatchThreshold: 40 موصى به؛ يُعاير بعد تجربة الجهاز الفعلي.
  // ============================================================================
  "Fingerprint": {
    "Enabled": true,
    "Matcher": "sourceafis",
    "MatchThreshold": 40,
    "SamplesPerEnrollment": 3,
    "MaxFingersPerUser": 3,
    "EncryptionKey": ""
  },
  "Backup": {
    "Pbkdf2Iterations": 200000
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=cash;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    // رمز الدخول قصير العمر، والواجهة تجدده تلقائياً قبل انتهائه برمز التحديث.
    "ExpireMinutes": 60,
    "RefreshExpireDays": 20,
    "Issuer": "cashbook-api",
    "Audience": "cashbook-client"
  },
  "ApiSettings": {
    // لا تُكتب قيمة المفتاح هنا.
    // للتطوير: dotnet user-secrets set "ApiSettings:Secret" "<قيمة عشوائية 32 حرفاً على الأقل>"
    // للإنتاج:  ضع السطر  ApiSettings__Secret=<القيمة>  في ملف .env
    "Secret": ""
  },

  // ============================================================================
  //  سجل التدقيق (Audit Trail) — تسجيل كل عملية يقوم بها أي مستخدم داخل النظام.
  //
  //  ملاحظات مهمة قبل التعديل:
  //   • LogReadRequests = true يعطيك صورة كاملة لكنه الأكثر تأثيراً في حجم الجدول
  //     (كل فتح شاشة = عدة نداءات قراءة). أوقفه إن أردت التركيز على التغييرات والدخول.
  //   • RetentionDays = 0 يعني احتفاظاً دائماً بلا أي حذف — الجدول سينمو بلا سقف.
  //   • Enabled = false يوقف التسجيل كاملاً بلا أي تأثير على عمل النظام.
  // ============================================================================
  "AuditSettings": {
    "Enabled": true,
    "LogRequestBodies": true,
    "LogQueryStrings": true,
    "LogReadRequests": false,
    "MaxBodyLength": 8000,
    "QueueCapacity": 5000,
    "BatchSize": 200,
    "MaxChangesPerSave": 200,
    "SlowRequestMs": 2000,
    "RetentionDays": 365,
    "RetentionSweepHours": 24,
    "RetryDelaySeconds": 5,
    "IncludeStackTrace": false,
    "ExcludedPaths": [
      "/API/Files",
      "/swagger",
      "/favicon"
    ]
  }
}
