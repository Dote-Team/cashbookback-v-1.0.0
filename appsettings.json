{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5003"
      }
    }
  },

  // ============================================================================
  //  خادم البريد — إرسال إشعار للعضو عند إضافته إلى منشأة.
  //
  //  ملاحظات قبل الضبط:
  //   • Enabled = false يعطّل الإرسال كاملاً بلا أي محاولة اتصال.
  //     إضافة العضو تنجح دائماً، وتُعاد حالة البريد في الاستجابة (emailSent).
  //   • لا تُكتب كلمة المرور هنا أبداً — ضعها في .env:
  //         MailSettings__Password=...            و   MailSettings__Email=...
  //   • UseSsl: true مع المنفذ 587 = STARTTLS، ومع المنفذ 465 = SSL من أول الاتصال.
  //     الخوادم العامة (Gmail / Outlook / Exchange) ترفض الاتصال بلا تشفير.
  //   • TimeoutSeconds يمنع تعليق الطلب على خادم لا يستجيب.
  // ============================================================================
  "MailSettings": {
    "Enabled": false,
    "FromName": "نظام الحسابات",
    "FromEmail": "",
    "SmtpServer": "",
    "SmtpPort": 587,
    "Email": "",
    "Password": "",
    "UseSsl": true,
    "TimeoutSeconds": 15
  },

  "CorsSettings": {
    "AllowedOrigins": [
      "https://backsmartgis.live",
      "http://localhost:3000",
      "http://127.0.0.1:5500"
    ]
  },

  "AllowedHosts": "*",

  // الحساب الذي يُمنح صلاحية «المدير الرئيسي» (Super Admin) تلقائياً عند الإقلاع.
  // تُطابَق باسم المستخدم أولاً ثم بالبريد. اتركهما فارغين لتعطيل المنح التلقائي.
  // ملاحظة: الحقلان Password و Role كانا موجودين هنا دون أن يقرأهما أي كود، وقد حُذفا
  // لأنهما كلمة مرور صريحة غير مستخدمة في ملف إعدادات.
  "AdminUser": {
    "Username": "",
    "Email": ""
  },
  "Backup": {
    "Pbkdf2Iterations": 200000
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=cash;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    // Issuer و Audience كانا هنا ولا يقرأهما أي كود (ValidateIssuer/ValidateAudience = false)، فحُذفا.
    "ExpireHours": "7",
    "RefreshExpireDays": "20"
  },
  "ApiSettings": {
    // لا تُكتب قيمة المفتاح هنا.
    // للتطوير: dotnet user-secrets set "ApiSettings:Secret" "<قيمة عشوائية 32 حرفاً على الأقل>"
    // للإنتاج:  ضع السطر  ApiSettings__Secret=<القيمة>  في ملف .env
    "Secret": ""
  },

  // ============================================================================
  //  سجل التدقيق (Audit Trail) — تسجيل كل عملية يقوم بها أي مستخدم داخل النظام.
  //
  //  ملاحظات مهمة قبل التعديل:
  //   • LogReadRequests = true يعطيك صورة كاملة لكنه الأكثر تأثيراً في حجم الجدول
  //     (كل فتح شاشة = عدة نداءات قراءة). أوقفه إن أردت التركيز على التغييرات والدخول.
  //   • RetentionDays = 0 يعني احتفاظاً دائماً بلا أي حذف — الجدول سينمو بلا سقف.
  //   • Enabled = false يوقف التسجيل كاملاً بلا أي تأثير على عمل النظام.
  // ============================================================================
  "AuditSettings": {
    "Enabled": true,
    "LogRequestBodies": true,
    "LogQueryStrings": true,
    "LogReadRequests": true,
    "MaxBodyLength": 8000,
    "QueueCapacity": 5000,
    "BatchSize": 200,
    "MaxChangesPerSave": 200,
    "SlowRequestMs": 2000,
    "RetentionDays": 365,
    "RetentionSweepHours": 24,
    "RetryDelaySeconds": 5,
    "IncludeStackTrace": false,
    "ExcludedPaths": [
      "/API/Files",
      "/swagger",
      "/favicon"
    ]
  }
}
