# ملفات لا تُرسَل إلى محرّك Docker عند البناء (تعجيل البناء وتقليل الحجم)

# مخرجات البناء — تُبنى داخل الصورة من جديد
**/bin/
**/obj/
**/out/
**/publish/
**/Release/
**/Debug/

# مجلدات المحرّرات
**/.vs/
**/.vscode/
**/.idea/

# مستودع Git
**/.git/
**/.gitignore
**/.gitattributes

# ===== الأسرار: لا تدخل الصورة مطلقاً =====
# القيم الحسّاسة تُمرَّر وقت التشغيل: إمّا متغيّرات بيئة في docker-compose،
# أو ملف .env يُثبَّت (volume) أو env_file — وأي منها لا يُخبَز في طبقة الصورة.
.env
.env.*
*.pfx
*.p12

# أدوات Docker نفسها (Docker يقرأ Dockerfile بنفسه ولا يحتاجه في السياق)
Dockerfile*
docker-compose*

# ملفات توثيق وتطوير وأرشيفات
*.md
*.pdf
*.rar
*.zip
*.http
*.user
*.suo
*.userprefs
*.code-workspace

# مرفقات التطوير المحلية — في الإنتاج يأتي مكانها volume فارغ
wwwroot/uploads/*
!wwwroot/uploads/.gitkeep

# البرنامج الوسيط للبصمة يعمل على أجهزة المستخدمين لا في الخادم
tools/

# اختبارات التكامل تعمل من جهاز التطوير، لا داخل الصورة
tests/

# سكربتات البيانات التجريبية تُشغَّل يدوياً على القاعدة، والتطبيق لا يقرؤها
Seed/
