# ============================================================================
#  قالب ملف الأسرار والإعدادات — انسخه إلى .env ثم املأ القيم
#
#      copy .env.example .env          (ويندوز)
#      cp   .env.example .env          (لينكس/ماك)
#
#  .env مُستثنى من Git ولا يدخل صورة Docker أبداً.
#  القاعدة: اسم المفتاح = مسار الإعداد في appsettings.json، والنقطتان تُكتبان
#  شرطتين سفليتين:  "ApiSettings:Secret"  ⟶  ApiSettings__Secret
#  ملاحظة: لو وُجد المفتاح نفسه متغيّرَ بيئة في Docker و في .env داخل الحاوية،
#  فالقيمة الغالبة هي قيمة .env (لأن التطبيق يقرأ الملف بعد متغيّرات البيئة).
# ============================================================================

# ---------------------------------------------------------------------------
#  للـ docker-compose فقط (لا يقرأها التطبيق)
# ---------------------------------------------------------------------------
# كلمة مرور حساب sa لخادم SQL داخل الحاوية — 8 أحرف على الأقل، وبحرف كبير
# ورقم ورمز (هذا شرط صورة SQL Server نفسه، وإلا رفضت الإقلاع).
MSSQL_SA_PASSWORD=Str0ng!Passw0rd

# المنفذ الذي تظهر عليه واجهة البرمجة على الخادم (5003 هو ما تتوقعه الواجهة)
API_PORT=5003
# المنفذ الذي يظهر عليه SQL Server (اتركه مغلقاً في الإنتاج: علّق السطر في
# docker-compose.yml). 14330 وليس 1433 عمداً حتى لا يتعارض مع خادم SQL آخر
# يعمل على الجهاز نفسه — والحاويتان تتخاطبان داخلياً بلا حاجة لهذا المنفذ.
DB_PORT=14330

# ===========================================================================
#  ١) أسرار إلزامية — التطبيق لا يُقلع بدونها
# ===========================================================================

# مفتاح توقيع رموز الدخول: 32 حرفاً على الأقل، خاص بهذا الخادم،
# ولا يُستخدم مفتاح جهاز التطوير. ولّده بعد بناء الصورة بأمر:
#     docker run --rm --entrypoint dotnet cashbook-api:latest cashbook.dll --generate-secret
# أو من جهاز التطوير:  dotnet run -- --generate-secret
ApiSettings__Secret=

# سلسلة الاتصال.
#  • إن كانت قاعدة البيانات داخل Docker (خدمة db في docker-compose.yml):
ConnectionStrings__DefaultConnection=Server=db,1433;Database=cash;User Id=sa;Password=Str0ng!Passw0rd;Encrypt=False;TrustServerCertificate=True
#  • وإن كانت قاعدة بيانات جاهزة على الخادم أو مُدارة، استبدلها بمثال:
# ConnectionStrings__DefaultConnection=Server=localhost\\SQLEXPRESS;Database=cash;User Id=sa;Password=كلمة_المرور;Encrypt=True;TrustServerCertificate=True;
#  • Windows Authentication لا تعمل من داخل الحاوية، فيلزم مستخدم SQL.

# ===========================================================================
#  ٢) إعدادات مهمّة
# ===========================================================================

# السوبر أدمن الرئيسي: يُنشأ تلقائياً عند أول إقلاع إن لم يكن موجوداً، أو يُرقّى الحساب
# الموجود بهذا الاسم. هو من ينشئ المنشآت والخزائن والأدمن. التسجيل الذاتي مغلق.
# كلمة المرور تُستخدم عند الإنشاء الأول فقط؛ بعدها غيّرها من النظام واحذف السطر إن شئت.
AdminUser__Username=
AdminUser__Email=
AdminUser__Password=

# ===========================================================================
#  الدخول بالبصمة (ZK9500)
# ===========================================================================
# مفتاح تشفير قوالب البصمات (AES-256، 32 بايت Base64). ولّده بالأمر:
#     dotnet cashbook.dll --generate-secret
# لا تغيّره بعد تسجيل البصمات، وإلا تعذّر فك القوالب ولزم إعادة تسجيلها.
Fingerprint__EncryptionKey=
# المحرّك: sourceafis للإنتاج. (dev للتجربة على جهاز التطوير فقط مع البرنامج الوسيط في وضع المحاكاة)
# Fingerprint__Matcher=sourceafis
# حد قبول التطابق (يُعاير بعد وصول الجهاز). الأعلى = أشد.
# Fingerprint__MatchThreshold=40

# ===========================================================================
#  ٣) الواجهة الأمامية (CORS) — الفهارس تبدأ من صفر
# ===========================================================================
# نطاق الواجهة الفعلي بلا شرطة أخيرة. إن كانت الواجهة على منفذ غير المنفذ 80/443
CorsSettings__AllowedOrigins__0=https://backsmartgis.live
CorsSettings__AllowedOrigins__1=http://localhost:3000
# CorsSettings__AllowedOrigins__2=http://192.168.1.50:3000

# ===========================================================================
#  ٤) خادم البريد (اختياري — التفصيل في MAIL-SETUP.md)
# ===========================================================================
MailSettings__Enabled=false
# MailSettings__FromName=نظام الحسابات
# MailSettings__FromEmail=no-reply@example.com
# MailSettings__SmtpServer=smtp.gmail.com
# MailSettings__SmtpPort=587
# MailSettings__Email=no-reply@example.com
# MailSettings__Password=كلمة_مرور_التطبيق
# MailSettings__UseSsl=true

# ===========================================================================
#  ٥) إعدادات يمكن تركها على قيم appsettings.json
# ===========================================================================
# حدّاد تسجيل الدخول وسجلّ التدقيق والنسخ الاحتياطي لها قيم افتراضية صالحة في
# appsettings.json. اكتب هنا فقط ما تريد تغييره فعلاً، مثل:
# AuditSettings__RetentionDays=180
# AuditSettings__LogReadRequests=false
# Backup__Pbkdf2Iterations=300000
