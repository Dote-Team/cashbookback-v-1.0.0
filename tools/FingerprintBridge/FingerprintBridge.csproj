<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    البرنامج الوسيط لقارئ البصمة ZK9500. يعمل على جهاز المستخدم (Windows)، يلتقط صورة
    البصمة عبر ZKFinger SDK ويعيدها للمتصفح. لا يطابق ولا يخزّن شيئاً: المطابقة في الخادم.
    النشر: انظر README.md
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CashbookFingerprintBridge</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

</Project>
