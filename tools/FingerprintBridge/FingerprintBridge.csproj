<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    البرنامج الوسيط لقارئ البصمة ZK9500. يعمل على جهاز المستخدم (Windows)، يلتقط صورة
    البصمة عبر ZKFinger SDK ويعيدها للمتصفح. لا يطابق ولا يخزّن شيئاً: المطابقة في الخادم.
    التثبيت كخدمة: scripts/install-service.cmd (كمسؤول). إعادة البناء: dotnet publish بإعدادات Release و win-x64 وملف تنفيذي واحد، إلى المجلد publish.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CashbookFingerprintBridge</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <!-- ملفات التثبيت تُنسخ بجانب البرنامج عند النشر. -->
  <ItemGroup>
    <None Include="scripts\*.cmd" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
